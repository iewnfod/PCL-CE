<Styles
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:PCL.Avalonia.Controls">

    <!-- 1:1 复刻 WPF MyCheckBox：18×18 方框（边 1.1、圆角 3、HalfWhite 底）+
         对勾/不定态方块弹出动画 + 按下 16.5 缩放 + 底色 Bg1 -->
    <Styles.Resources>
        <ControlTheme x:Key="{x:Type controls:MyCheckBox}" TargetType="controls:MyCheckBox">
            <Setter Property="MinWidth" Value="20" />
            <Setter Property="MinHeight" Value="20" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Foreground" Value="{DynamicResource ColorBrush1}" />
            <Setter Property="BorderBrush" Value="{DynamicResource ColorBrush1}" />
            <Setter Property="Background" Value="{DynamicResource ColorBrushHalfWhite}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Template">
                <ControlTemplate>
                    <Panel Background="Transparent">
                        <TextBlock x:Name="PART_Text" Text="{TemplateBinding Text}"
                                   FontSize="{TemplateBinding FontSize}"
                                   Foreground="{TemplateBinding Foreground}"
                                   Margin="26,0,0,0"
                                   HorizontalAlignment="Left" VerticalAlignment="Center"
                                   IsHitTestVisible="False" />
                        <!-- 方框 -->
                        <Border x:Name="PART_Border" Width="18" Height="18"
                                BorderThickness="1.1" CornerRadius="3"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                Background="{TemplateBinding Background}"
                                HorizontalAlignment="Left" VerticalAlignment="Center"
                                Margin="1,0,0,0" IsHitTestVisible="False" />
                        <!-- 对勾（WPF: M0,6L1.5,4.5 4.5,7.5 10.5,1.5 12,3 4.5,10.5 0,6z） -->
                        <Path x:Name="PART_Check" Width="12" Height="12" Margin="4,0,0,0"
                              Fill="{TemplateBinding BorderBrush}"
                              Data="M0,6L1.5,4.5 4.5,7.5 10.5,1.5 12,3 4.5,10.5 0,6z"
                              Stretch="Uniform"
                              HorizontalAlignment="Left" VerticalAlignment="Center"
                              RenderTransformOrigin="50%, 50%"
                              RenderTransform="scale(0,0)" IsHitTestVisible="False" />
                        <!-- 不定态方块 -->
                        <Border x:Name="PART_Indeterminate" Width="10" Height="10" Margin="5,0,0,0"
                                CornerRadius="2"
                                Background="{TemplateBinding BorderBrush}"
                                HorizontalAlignment="Left" VerticalAlignment="Center"
                                RenderTransformOrigin="50%, 50%"
                                RenderTransform="scale(0,0)" IsHitTestVisible="False" />
                    </Panel>
                </ControlTemplate>
            </Setter>

            <!-- 悬停：文字/边框 → ColorBrush3（入 100ms / 出 200ms → 150ms 折中） -->
            <Style Selector="^">
                <Setter Property="Transitions">
                    <Transitions>
                        <BrushTransition Property="Foreground" Duration="0:0:0.15" />
                        <BrushTransition Property="BorderBrush" Duration="0:0:0.15" />
                        <BrushTransition Property="Background" Duration="0:0:0.1" />
                    </Transitions>
                </Setter>
            </Style>
            <Style Selector="^:pointerover">
                <Setter Property="Foreground" Value="{DynamicResource ColorBrush3}" />
                <Setter Property="BorderBrush" Value="{DynamicResource ColorBrush3}" />
            </Style>
            <Style Selector="^:checked">
                <Setter Property="BorderBrush" Value="{DynamicResource ColorBrush2}" />
            </Style>
            <Style Selector="^:checked:pointerover">
                <Setter Property="BorderBrush" Value="{DynamicResource ColorBrush3}" />
            </Style>

            <!-- 按下：方框缩至 16.5、底色 Bg1、对勾 0.9（WPF 1000ms Strong Fluent → 100ms） -->
            <Style Selector="^ /template/ Border#PART_Border">
                <Setter Property="Transitions">
                    <Transitions>
                        <DoubleTransition Property="Width" Duration="0:0:0.1" />
                        <DoubleTransition Property="Height" Duration="0:0:0.1" />
                    </Transitions>
                </Setter>
            </Style>
            <Style Selector="^:pressed /template/ Border#PART_Border">
                <Setter Property="Width" Value="16.5" />
                <Setter Property="Height" Value="16.5" />
            </Style>
            <Style Selector="^:pressed">
                <Setter Property="Background" Value="{DynamicResource ColorBrushBg1}" />
            </Style>

            <!-- 对勾：300ms 弹性展开 / 135ms 收缩（WPF OutBack Weak / InFluent Weak） -->
            <Style Selector="^ /template/ Path#PART_Check">
                <Setter Property="Transitions">
                    <Transitions>
                        <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.2">
                            <TransformOperationsTransition.Easing>
                                <SplineEasing X1="0.34" Y1="1.4" X2="0.64" Y2="1" />
                            </TransformOperationsTransition.Easing>
                        </TransformOperationsTransition>
                    </Transitions>
                </Setter>
            </Style>
            <Style Selector="^:checked /template/ Path#PART_Check">
                <Setter Property="RenderTransform" Value="scale(1,1)" />
            </Style>

            <!-- 不定态方块：同对勾动画 -->
            <Style Selector="^ /template/ Border#PART_Indeterminate">
                <Setter Property="Transitions">
                    <Transitions>
                        <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.2">
                            <TransformOperationsTransition.Easing>
                                <SplineEasing X1="0.34" Y1="1.4" X2="0.64" Y2="1" />
                            </TransformOperationsTransition.Easing>
                        </TransformOperationsTransition>
                    </Transitions>
                </Setter>
            </Style>
            <Style Selector="^:indeterminate /template/ Border#PART_Indeterminate">
                <Setter Property="RenderTransform" Value="scale(1,1)" />
            </Style>

            <!-- 禁用：Gray4 -->
            <Style Selector="^:disabled">
                <Setter Property="Foreground" Value="{DynamicResource ColorBrushGray4}" />
                <Setter Property="BorderBrush" Value="{DynamicResource ColorBrushGray4}" />
            </Style>
        </ControlTheme>
    </Styles.Resources>
</Styles>
