<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="PCL.Avalonia.App"
             RequestedThemeVariant="Light">
    <Application.Styles>
        <FluentTheme />
        <StyleInclude Source="avares://PCL.CE.Avalonia/Controls/PclStyles.axaml" />
        <StyleInclude Source="avares://PCL.CE.Avalonia/Controls/Themes/MyButton.axaml" />
        <StyleInclude Source="avares://PCL.CE.Avalonia/Controls/Themes/MyCard.axaml" />
        <StyleInclude Source="avares://PCL.CE.Avalonia/Controls/Themes/MyIconButton.axaml" />
        <StyleInclude Source="avares://PCL.CE.Avalonia/Controls/Themes/MyListItem.axaml" />
        <StyleInclude Source="avares://PCL.CE.Avalonia/Controls/Themes/MyCheckBox.axaml" />
        <StyleInclude Source="avares://PCL.CE.Avalonia/Controls/Themes/MyRadioButton.axaml" />
    </Application.Styles>
</Application>
