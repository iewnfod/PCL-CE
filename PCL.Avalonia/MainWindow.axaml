<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="using:PCL.Avalonia"
        x:Class="PCL.Avalonia.MainWindow"
        Title="Plain Craft Launcher CE"
        Width="920" Height="600"
        WindowStartupLocation="CenterScreen"
        MinWidth="760" MinHeight="480">

    <Panel>
        <!-- 标题栏拖拽区 + 装饰（系统装饰暂用默认，自绘标题栏在控件库阶段实现） -->
        <Grid ColumnDefinitions="220,*">
            <!-- 左侧导航栏 -->
            <Border Grid.Column="0" Background="#F2F2F2" Name="LeftPane" ZIndex="0">
                <StackPanel Margin="8,32,8,12" Spacing="4">
                    <TextBlock Text="PCL CE" FontSize="20" FontWeight="Bold" Margin="12,0,0,10" />
                    <Button Content="主页" Classes="nav" Command="{Binding NavigateHome}" />
                    <Button Content="启动" Classes="nav" Command="{Binding NavigateLaunch}" />
                    <Button Content="下载" Classes="nav" Command="{Binding NavigateDownload}" />
                    <Button Content="设置" Classes="nav" Command="{Binding NavigateSetup}" />
                    <Panel />
                    <TextBlock Text="{Binding StatusText}" FontSize="11" Opacity="0.55"
                               Margin="12,0,0,0" TextWrapping="Wrap" />
                </StackPanel>
            </Border>
            <!-- 内容区 -->
            <Border Grid.Column="1" Name="ContentRoot">
                <ContentControl Content="{Binding CurrentPage}" />
            </Border>
        </Grid>
    </Panel>

    <Window.Styles>
        <Style Selector="Button.nav">
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="Padding" Value="12,8" />
            <Setter Property="Margin" Value="0,1" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>
        <Style Selector="Button.nav:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#E4E4E4" />
        </Style>
    </Window.Styles>
</Window>
